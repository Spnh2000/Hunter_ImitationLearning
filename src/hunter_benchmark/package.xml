<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hunter_benchmark</name>
  <version>0.1.0</version>
  <description>Benchmark launch, metrics logging, and offline bag-summary tooling shared by every path-tracking controller phase</description>

  <maintainer email="sagharpanahi2@gmail.com">Sagha Panahi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hunter_msgs</depend>
  <exec_depend>hunter_gazebo</exec_depend>
  <exec_depend>hunter_trajectory</exec_depend>
  <exec_depend>hunter_control</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>ros2bag</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
