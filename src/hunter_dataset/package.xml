<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hunter_dataset</name>
  <version>0.1.0</version>
  <description>
    Phase 6 imitation-learning dataset tooling: the canonical schema
    (dataset_spec), the rosbag2 -> HDF5 converter, and the dataset inspector.

    Architecture: rosbag2 is recorded raw at full 1080 beams and treated as
    immutable; the HDF5 is a derived artifact produced by a versioned converter.
    A schema change is therefore a script re-run, not a re-collection.
  </description>
  <maintainer email="sagharpanahi2@gmail.com">Saghar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- dataset_spec.py deliberately depends on NOTHING here: Phase 8 training
       must import it from a torch/d3rlpy environment with no ROS present.
       These are for the converter and recorder only. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>hunter_msgs</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-h5py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <!-- record_expert.launch.py includes hunter_benchmark's launch and runs
       hunter_control's episode_monitor. They are deliberately NOT declared
       here: hunter_control -> hunter_il -> hunter_dataset (policy_tracker
       imports the schema), and declaring them back would make a cycle colcon
       refuses to order. Launch-time deps are resolved at run time, not build. -->
</package>
