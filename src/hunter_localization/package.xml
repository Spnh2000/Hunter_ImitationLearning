<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hunter_localization</name>
  <version>0.1.0</version>
  <description>
    Localization stack for the Hunter V2: LiDAR/IMU bridges, slam_toolbox, and a
    dual robot_localization EKF. The local EKF publishes a continuous
    odom-&gt;base_link at control rate; the global EKF absorbs slam_toolbox's
    discrete pose corrections into map-&gt;odom so trackers never see position
    steps. Config and launch only -- no compiled code.
  </description>
  <maintainer email="saqarpanahipour@email.com">Spnh2000</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch-time only: this package ships configuration and a launch file,
       and never links against any of these. -->
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
